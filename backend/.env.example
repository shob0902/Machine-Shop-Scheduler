# Flask environment: development | production
FLASK_ENV=development

# SQLite file path. Tests use a temp file per test session (see
# tests/test_api.py), not ':memory:' - db.py opens a fresh connection per
# operation, which would silently reset an in-memory database each time.
# Render's free tier disk is ephemeral too - see docs/system-design.md
# "Deployment" for notes on upgrading to a persistent disk or Postgres.
DATABASE_URL=./shop.db

# Origin allowed to call this API (Flask-CORS). Set to your deployed
# Netlify URL in production, e.g. https://machine-shop-scheduler.netlify.app
FRONTEND_URL=http://localhost:5173

# Fixed seed for synthetic data generation - change to get a
# different (still internally-consistent) dataset.
DATA_SEED=42
